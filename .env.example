# Postgres from the committed docker-compose.yml (host port 5433).
DATABASE_URL=postgres://wavy:wavy@localhost:5433/wavy

# Separate database on the same container, used by `pnpm test`.
# The integration test bootstrap creates it if it does not exist yet.
TEST_DATABASE_URL=postgres://wavy:wavy@localhost:5433/wavy_test

# HMAC key for the signed session cookie. Any non-empty string works locally.
AUTH_SECRET=dev-secret-change-me

# Third database on the same container, used by `pnpm test:e2e`.
# The Playwright global setup creates and migrates it if it does not exist yet.
E2E_DATABASE_URL=postgres://wavy:wavy@localhost:5433/wavy_e2e
